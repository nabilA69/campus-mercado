# ── Database ──────────────────────────────────────────────
# Local dev (SQLite): keep prisma/schema.prisma provider = "sqlite"
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL): set provider = "postgresql" in prisma/schema.prisma, then use e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Auth ──────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Automated ID verification (AI reads the Carné photo) ──
# Optional. Leave blank and verification falls back to the deterministic
# typed-No.CI ↔ date-of-birth match. Any OpenAI-compatible VISION provider works;
# the call is made by the server, so Cuban users are never blocked by it.
#
# CHOOSING A PROVIDER: this is a policy question, not a technical one. The call
# is made by the server, so no Cuban IP ever reaches the provider and any of
# them works technically — but the provider's own terms decide whether it may
# serve an audience that is entirely Cuban. Checked against their published
# lists: Anthropic and OpenAI both exclude Cuba, so neither is usable here.
# Confirm the policy of whoever you pick, in writing, before relying on it.
#
# Qwen3-VL (Alibaba Model Studio, Singapore region):
#   AI_VISION_BASE_URL="https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
#   AI_VISION_MODEL="qwen3-vl-plus"
#   The base URL is workspace-specific — the older dashscope-intl.aliyuncs.com
#   domain is being retired. The key must come from the SAME region as the
#   endpoint or every request returns 401.
#
# NOTE: DeepSeek is NOT usable here — its API is text-only (no image input).
AI_VISION_BASE_URL=""
AI_VISION_API_KEY=""
AI_VISION_MODEL=""
# Optional raw JSON merged into the request body, for provider-specific knobs.
# qwen3-vl-plus is a hybrid thinking model and may need thinking turned off to
# answer a non-streaming request:
#   AI_VISION_EXTRA_JSON='{"enable_thinking":false}'
AI_VISION_EXTRA_JSON=""

# ── Admin bootstrap (used by `npm run db:seed`) ───────────
ADMIN_EMAIL="admin@campusmercado.cu"
ADMIN_PASSWORD="change-this-strong-password"

# ── File storage ──────────────────────────────────────────
# local        -> writes to /public/uploads (dev, or a host with a persistent volume)
# vercel-blob  -> Vercel Blob (recommended on Vercel). Create a Blob store in the Vercel dashboard;
#                 it auto-injects BLOB_READ_WRITE_TOKEN. Nothing else to configure.
# s3           -> any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, MinIO)
STORAGE_DRIVER="local"
# Only needed when STORAGE_DRIVER=s3:
S3_BUCKET=""
S3_REGION="auto"                       # "auto" for Cloudflare R2; a real region for AWS
S3_ENDPOINT=""                         # e.g. https://<accountid>.r2.cloudflarestorage.com  (empty for AWS S3)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""                       # public base URL of the bucket, e.g. https://cdn.yourdomain.com
S3_FORCE_PATH_STYLE="false"            # "true" for MinIO / some providers

# ── Transfermóvil (platform-fee payments) ─────────────────
#
# Two ways to get paid, and only the first needs no paperwork.
#
# 1. CARD-TO-CARD (works today). Set TRANSFERMOVIL_ACCOUNT to the 16-digit
#    tarjeta that should receive the money. The pay page shows it as a
#    tap-to-copy field with the payment reference, the buyer transfers by hand
#    putting that reference in the "concepto", and an admin confirms the
#    payment under /admin/payments after checking the account.
#
# 2. PROVIDER CODE (needs a bank contract). Cuban banks issue registered
#    businesses a código de proveedor, which is what makes a QR that
#    Transfermóvil can actually act on. When you have one, fill in the QR
#    variables below and the pay page switches to showing a real QR — no code
#    change needed. Ask your branch (BANDEC / BPA / Metropolitano) what the
#    payload format is; it is set by them, not by us.
#
# Leaving the QR variables empty is deliberate and correct until then: a QR
# encoding our own text would scan to a paragraph and pay nobody, so the page
# shows the copyable card number instead.

TRANSFERMOVIL_ACCOUNT="9205 1299 0000 0000"
# Your real exported merchant QR, as an image URL — shown as-is when set.
TRANSFERMOVIL_QR_URL=""
# Bank-issued payload encoded into a generated QR. Placeholders: {account} {amount} {currency} {ref}
TRANSFERMOVIL_QR_PAYLOAD=""
# Deep-link URI that opens the app at the payment. Placeholders: {account} {amount} {ref}
TRANSFERMOVIL_DEEPLINK=""

# ── Pilot config ──────────────────────────────────────────
NEXT_PUBLIC_UNIVERSITY_NAME="Universidad piloto"
